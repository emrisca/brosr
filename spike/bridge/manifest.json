{
  "manifest_version": 2,
  "name": "Brosr bridge (spike)",
  "version": "0.1.0",
  "description": "Loads the Brosr core into a room tab: cursors, presence and media sync.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@brosr.spike",
      "strict_min_version": "115.0"
    }
  },
  "permissions": [
    "tabs",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "core/*.mjs"
  ],
  "commands": {
    "open-room-panel": {
      "suggested_key": {
        "default": "Ctrl+Alt+B",
        "mac": "MacCtrl+Alt+B"
      },
      "description": "Open the Brosr room panel"
    }
  },
  "sidebar_action": {
    "default_title": "Brosr room",
    "default_panel": "panel/room.html"
  },
  "browser_action": {
    "default_title": "Brosr room"
  }
}
