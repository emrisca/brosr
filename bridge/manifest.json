{
  "manifest_version": 2,
  "name": "Brosr bridge",
  "version": "0.1.3",
  "description": "Loads the Brosr core into a room tab: cursors, presence and media sync.",
  "browser_specific_settings": {
    "gecko": {
      "id": "bridge@brosr.app",
      "strict_min_version": "140.0",
      "data_collection_permissions": {
        "required": ["browsingActivity", "websiteActivity"]
      }
    },
    "gecko_android": {
      "strict_min_version": "142.0"
    }
  },
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "96": "assets/icon-96.png",
    "128": "assets/icon-128.png"
  },
  "permissions": [
    "tabs",
    "storage",
    "http://127.0.0.1/*"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "content_scripts": [
    {
      "matches": [
        "http://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    "core/*.mjs"
  ],
  "commands": {
    "open-room-panel": {
      "suggested_key": {
        "default": "Ctrl+Alt+B",
        "mac": "MacCtrl+Alt+B"
      },
      "description": "Show the Brosr room panel"
    }
  },
  "browser_action": {
    "default_title": "Brosr room",
    "default_area": "navbar",
    "default_popup": "panel/room.html?surface=popup",
    "default_icon": {
      "16": "assets/action-16.png",
      "32": "assets/action-32.png",
      "48": "assets/action-48.png"
    }
  }
}
