{
  "manifest_version": 3,
  "name": "Brosr bridge",
  "version": "0.4.3",
  "description": "Loads the Brosr core into a room tab: cursors, presence and media sync.",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "96": "assets/icon-96.png",
    "128": "assets/icon-128.png"
  },
  "permissions": ["tabs", "storage"],
  "host_permissions": ["http://127.0.0.1/*", "http://*/*", "https://*/*"],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content.js"],
      "all_frames": true,
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["core/*.mjs", "bridge-youtube.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ],
  "commands": {
    "open-room-panel": {
      "suggested_key": {
        "default": "Ctrl+Shift+B",
        "mac": "Command+Shift+B"
      },
      "description": "Show the Brosr room panel"
    }
  },
  "action": {
    "default_title": "Brosr room",
    "default_popup": "panel/room.html?surface=popup",
    "default_icon": {
      "16": "assets/action-16.png",
      "32": "assets/action-32.png",
      "48": "assets/action-48.png"
    }
  }
}
